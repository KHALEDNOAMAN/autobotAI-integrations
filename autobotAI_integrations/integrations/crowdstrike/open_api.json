        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ids": { "type": "array", "items": { "type": "string" } },
                  "status": { "type": "string" },
                  "assigned_to_uuid": { "type": "string" },
                  "show_in_ui": { "type": "boolean" }
                },
                "required": ["ids"]
              }
            }
          }
        },
        "responses": { "200": { "description": "Update successful" } }
      }
    },
    "/detects/aggregates/detects/GET/v1": {
      "post": {
        "operationId": "aggregate_detects",
        "summary": "Aggregate detections",
        "tags": ["EDR - Detects"],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "type": "object", "additionalProperties": true }
            }
          }
        },
        "responses": { "200": { "description": "Aggregate successful" } }
      }
    },
