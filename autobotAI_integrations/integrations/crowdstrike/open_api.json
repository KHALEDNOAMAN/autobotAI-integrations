{
  "openapi": "3.0.0",
  "info": {
    "title": "CrowdStrike Falcon API",
    "version": "2.0.0",
    "description": "Unified CrowdStrike Falcon API covering Endpoint Detection & Response (Detects, Hosts, Incidents, Alerts, Real-Time Response) and Identity Protection (sensors, GraphQL, policy rules).",
    "contact": {
      "name": "CrowdStrike Developer Center",
      "url": "https://developer.crowdstrike.com/api-reference/"
    }
  },
  "servers": [
    {
      "url": "{base_url}",
      "variables": {
        "base_url": {
          "default": "https://api.us-2.crowdstrike.com"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SensorAggregateRequest": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "date_ranges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" }
                }
              }
            },
            "exclude": { "type": "string" },
            "field": { "type": "string" },
            "filter": { "type": "string" },
            "from": { "type": "integer" },
            "include": { "type": "string" },
            "interval": { "type": "string" },
            "max_doc_count": { "type": "integer" },
            "min_doc_count": { "type": "integer" },
            "missing": { "type": "string" },
            "name": { "type": "string" },
            "q": { "type": "string" },
            "ranges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "From": { "type": "integer" },
                  "To": { "type": "integer" }
                }
              }
            },
            "size": { "type": "integer" },
            "sort": { "type": "string" },
            "sub_aggregates": {
              "type": "array",
              "items": { "type": "object" }
            },
            "time_zone": { "type": "string" },
            "type": { "type": "string" }
          }
        }
      },
      "SensorDetailsRequest": {
        "type": "object",
        "required": ["ids"],
        "properties": {
          "ids": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "array",
                "items": { "type": "string" }
              }
            ],
            "description": "Sensor IDs to retrieve (max 5000)"
          }
        }
      },
      "GraphQLRequest": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string",
            "description": "GraphQL query string"
          },
          "variables": {
            "type": "object",
            "description": "Variables for the GraphQL query"
          }
        }
      },
      "PolicyRuleRequest": {
        "type": "object",
        "properties": {
          "action": { "type": "string" },
          "activity": { "type": "object" },
          "destination": { "type": "object" },
          "enabled": { "type": "boolean" },
          "name": { "type": "string" },
          "simulationMode": { "type": "boolean" },
          "sourceEndpoint": { "type": "object" },
          "sourceUser": { "type": "object" },
          "trigger": { "type": "string" }
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "resources": { "type": "array", "items": { "type": "object" } },
          "errors": { "type": "array", "items": { "type": "object" } },
          "meta": { "type": "object" }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/detects/queries/detects/v1": {
      "get": {
        "operationId": "query_detects",
        "summary": "Query detections by filter",
        "description": "Search for detection IDs that match a given FQL query.",
        "tags": ["EDR - Detects"],
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 100, "minimum": 1, "maximum": 9999 }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0, "minimum": 0 }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "Query successful" } }
      }
    },
    "/detects/entities/summaries/GET/v1": {
      "post": {
        "operationId": "get_detect_summaries",
        "summary": "Get detection summaries by IDs",
        "tags": ["EDR - Detects"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ids": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["ids"]
              }
            }
          }
        },
        "responses": { "200": { "description": "Fetch successful" } }
      }
    },
    "/detects/entities/detects/v2": {
